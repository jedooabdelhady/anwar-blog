/**
 * Cloudflare Workers deployment config (OpenNext output).
 *
 * Deploys as a Worker + Assets binding — the modern Cloudflare
 * pattern that Cloudflare Pages doesn't understand yet. Run
 * `npm run deploy` locally to publish; secrets are stored server-
 * side via `wrangler secret put` (see README-cloudflare-deploy.md).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sahaarr299",
  "main": ".open-next/worker.js",
  // Bumped to a recent date so the Workers runtime picks up all the
  // latest Node compat shims and streams behaviour OpenNext relies on.
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Custom domain routes — binds sahaarr299.com (+ www) to this Worker.
  // The zone is managed by Cloudflare (nameservers moved from Namecheap),
  // so `custom_domain: true` auto-provisions the DNS record + SSL cert.
  "routes": [
    { "pattern": "sahaarr299.com", "custom_domain": true },
    { "pattern": "www.sahaarr299.com", "custom_domain": true }
  ],
  // Public (non-secret) env vars. Anything sensitive is stored via
  // `wrangler secret put` and lives in Cloudflare's encrypted store.
  "vars": {
    "NEXT_PUBLIC_SANITY_PROJECT_ID": "oziuv7qc",
    "NEXT_PUBLIC_SANITY_DATASET": "production",
    "NEXT_PUBLIC_SANITY_API_VERSION": "2025-01-01",
    "NEXT_PUBLIC_SITE_URL": "https://sahaarr299.com",
    "CONTACT_EMAIL_TO": "sahaarr299@gmail.com",
    "CONTACT_EMAIL_FROM": "no-reply@sahaarr299.com",
    "GOOGLE_SITE_VERIFICATION": "6neLp4rpIoToKM8bi0c3XWWY_MyuqUNKQ94G0kWgsr4"
  },
  "observability": {
    "enabled": true
  }
}
